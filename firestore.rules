rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Shared Security Primitives ----------
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isRootAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'aiub.muhib@gmail.com';
    }

    function isAdmin() {
      return isRootAdminEmail() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ---------- Validation Blueprints ----------
    function isValidAcashUser(data) {
      return data.keys().hasAll([
          'accountId', 'role', 'name', 'phone', 'email', 'pinHash',
          'balance', 'commissionBalance', 'status', 'verified', 'createdAt', 'lastActiveAt'
        ])
        && data.keys().hasOnly([
          'accountId', 'firebaseUid', 'role', 'name', 'businessName', 'gender', 'termsAcceptedAt', 'phone', 'email',
          'pinHash', 'staffPinHash', 'profilePhotoUrl', 'kyc', 'mapLocation', 'balance', 'commissionBalance',
          'status', 'disableReason', 'disabledAt', 'disabledBy', 'verified',
          'referredByType', 'referredByAgentId', 'referredByAgentPhone', 'referredByAgentName',
          'createdAt', 'lastActiveAt'
        ])
        && data.accountId is string && data.accountId.size() <= 12 && data.accountId.matches('^[UAM]-\\d{6}$')
        && (!('firebaseUid' in data) || (data.firebaseUid is string && data.firebaseUid.size() <= 128))
        && data.role in ['U', 'A', 'M']
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 140))
        && (!('gender' in data) || data.gender in ['male', 'female'])
        && (!('termsAcceptedAt' in data) || data.termsAcceptedAt is number)
        && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 20
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.pinHash is string && data.pinHash.size() > 0 && data.pinHash.size() <= 64
        && (!('staffPinHash' in data) || (data.staffPinHash is string && data.staffPinHash.size() <= 64))
        && (!('profilePhotoUrl' in data) || (data.profilePhotoUrl is string && data.profilePhotoUrl.size() <= 500000))
        && (!('kyc' in data) || data.kyc is map)
        && (!('mapLocation' in data) || data.mapLocation is map)
        && data.balance is number && data.balance >= 0
        && data.commissionBalance is number && data.commissionBalance >= 0
        && data.status in ['active', 'disabled']
        && (!('disableReason' in data) || (data.disableReason is string && data.disableReason.size() <= 400))
        && (!('disabledAt' in data) || data.disabledAt is number)
        && (!('disabledBy' in data) || (data.disabledBy is string && data.disabledBy.size() <= 160))
        && data.verified is bool
        && (!('referredByType' in data) || data.referredByType in ['own_app', 'agent'])
        && (!('referredByAgentId' in data) || (data.referredByAgentId is string && data.referredByAgentId.size() <= 20))
        && (!('referredByAgentPhone' in data) || (data.referredByAgentPhone is string && data.referredByAgentPhone.size() <= 20))
        && (!('referredByAgentName' in data) || (data.referredByAgentName is string && data.referredByAgentName.size() <= 140))
        && data.createdAt is number
        && data.lastActiveAt is number;
    }

    function isValidAcashTransaction(data) {
      return data.keys().hasAll([
          'txId', 'txHash', 'type', 'senderId', 'senderName', 'senderPhone', 'senderRole',
          'receiverId', 'receiverName', 'receiverPhone', 'receiverRole',
          'amount', 'fee', 'totalDebited', 'feeBreakdown', 'status', 'refundedAmount', 'createdAt'
        ])
        && data.keys().hasOnly([
          'txId', 'txHash', 'type', 'senderId', 'senderUid', 'senderName', 'senderPhone', 'senderRole',
          'receiverId', 'receiverUid', 'receiverName', 'receiverPhone', 'receiverRole',
          'amount', 'fee', 'totalDebited', 'feeBreakdown', 'status', 'refundedAmount',
          'parentTxHash', 'operator', 'rechargeNumber', 'rechargeType',
          'biller', 'billAccountNumber', 'billMonth', 'note',
          'createdAt', 'approvedBy', 'approvedAt', 'rejectionReason', 'settledOnce'
        ])
        && data.txId is string && data.txId.size() > 0 && data.txId.size() <= 64
        && data.txHash is string && data.txHash.size() > 0 && data.txHash.size() <= 64
        && data.type in [
          'send_money', 'cash_out', 'cash_in', 'agent_cash_out', 'merchant_cash_out',
          'mobile_recharge', 'bill_pay', 'merchant_payment', 'b2b_transfer', 'refund',
          'admin_credit', 'admin_transfer'
        ]
        && data.senderId is string && data.senderId.size() <= 32
        && (!('senderUid' in data) || (data.senderUid is string && data.senderUid.size() <= 128))
        && data.senderName is string && data.senderName.size() <= 140
        && data.senderPhone is string && data.senderPhone.size() <= 30
        && data.senderRole is string && data.senderRole.size() <= 16
        && data.receiverId is string && data.receiverId.size() <= 32
        && (!('receiverUid' in data) || (data.receiverUid is string && data.receiverUid.size() <= 128))
        && data.receiverName is string && data.receiverName.size() <= 140
        && data.receiverPhone is string && data.receiverPhone.size() <= 30
        && data.receiverRole is string && data.receiverRole.size() <= 16
        && data.amount is number && data.amount > 0
        && data.fee is number && data.fee >= 0
        && data.totalDebited is number && data.totalDebited >= 0
        && data.feeBreakdown is map
        && data.status in ['completed', 'pending_admin_approval', 'rejected', 'refunded', 'partially_refunded']
        && data.refundedAmount is number && data.refundedAmount >= 0
        && (!('parentTxHash' in data) || (data.parentTxHash is string && data.parentTxHash.size() <= 64))
        && (!('operator' in data) || (data.operator is string && data.operator.size() <= 32))
        && (!('rechargeNumber' in data) || (data.rechargeNumber is string && data.rechargeNumber.size() <= 30))
        && (!('rechargeType' in data) || data.rechargeType in ['prepaid', 'postpaid'])
        && (!('biller' in data) || (data.biller is string && data.biller.size() <= 32))
        && (!('billAccountNumber' in data) || (data.billAccountNumber is string && data.billAccountNumber.size() <= 64))
        && (!('billMonth' in data) || (data.billMonth is string && data.billMonth.size() <= 40))
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && data.createdAt is number
        && (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 160))
        && (!('approvedAt' in data) || data.approvedAt is number)
        && (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 300))
        && (!('settledOnce' in data) || data.settledOnce is bool);
    }

    function isValidAcashBooth(data) {
      return data.keys().hasAll([
          'boothId', 'boothType', 'name', 'area', 'city', 'address',
          'phone', 'hours', 'status', 'lat', 'lng', 'services', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'boothId', 'boothType', 'name', 'area', 'city', 'address', 'phone',
          'agentAccountId', 'hours', 'status', 'lat', 'lng', 'services',
          'queueWaitMinutes', 'cashLiquidityLevel', 'createdAt', 'updatedAt'
        ])
        && data.boothId is string && data.boothId.size() > 0 && data.boothId.size() <= 64
        && data.boothType in ['agent_booth', 'support_booth']
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.area is string && data.area.size() > 0 && data.area.size() <= 80
        && data.city is string && data.city.size() > 0 && data.city.size() <= 60
        && data.address is string && data.address.size() > 0 && data.address.size() <= 240
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30
        && (!('agentAccountId' in data) || (data.agentAccountId is string && data.agentAccountId.size() <= 20))
        && data.hours is string && data.hours.size() > 0 && data.hours.size() <= 80
        && data.status in ['open', 'busy', 'closed']
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.services is list && data.services.size() <= 10
        && (data.services.size() == 0 || data.services[0] is string)
        && (!('queueWaitMinutes' in data) || (data.queueWaitMinutes is number && data.queueWaitMinutes >= 0))
        && (!('cashLiquidityLevel' in data) || data.cashLiquidityLevel in ['high', 'medium', 'low'])
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidAdminNotification(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'category', 'severity', 'createdAt', 'read'])
        && data.keys().hasOnly(['id', 'title', 'message', 'category', 'severity', 'createdAt', 'read', 'targetSection'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.title is string && data.title.size() <= 160
        && data.message is string && data.message.size() <= 500
        && data.category in ['aml_pending', 'account_status', 'treasury', 'fee_update', 'registration', 'kyc_update']
        && data.severity in ['critical', 'warning', 'info']
        && data.createdAt is number
        && data.read is bool
        && (!('targetSection' in data) || (data.targetSection is string && data.targetSection.size() <= 32));
    }

    function isValidAdminActivityLog(data) {
      return data.keys().hasAll(['id', 'actionType', 'title', 'details', 'actorEmail', 'timestamp'])
        && data.keys().hasOnly(['id', 'actionType', 'title', 'details', 'actorEmail', 'targetIds', 'amount', 'timestamp'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.actionType in [
          'fee_update', 'fund_transfer', 'credit_add', 'bulk_status_change',
          'status_change', 'aml_decision', 'alert_settings', 'security_update'
        ]
        && data.title is string && data.title.size() <= 160
        && data.details is string && data.details.size() <= 800
        && data.actorEmail is string && data.actorEmail.size() <= 160
        && (!('targetIds' in data) || (data.targetIds is list && data.targetIds.size() <= 100 && (data.targetIds.size() == 0 || data.targetIds[0] is string)))
        && (!('amount' in data) || data.amount is number)
        && data.timestamp is number;
    }

    function isValidAcashMapLocation(data) {
      return data.keys().hasAll([
          'creatorId', 'creatorRole', 'name', 'phone', 'address', 'area', 'city',
          'lat', 'lng', 'isVisible', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'creatorId', 'creatorUid', 'creatorRole', 'name', 'businessName', 'phone',
          'profilePhotoUrl', 'address', 'area', 'city', 'lat', 'lng', 'isVisible',
          'createdAt', 'updatedAt'
        ])
        && data.creatorId is string && data.creatorId.size() > 0 && data.creatorId.size() <= 64
        && data.creatorId.matches('^[a-zA-Z0-9_\\-]+$')
        && (!('creatorUid' in data) || (data.creatorUid is string && data.creatorUid.size() <= 128))
        && data.creatorRole in ['agent', 'merchant', 'second_admin']
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 140))
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30
        && (!('profilePhotoUrl' in data) || (data.profilePhotoUrl is string && data.profilePhotoUrl.size() <= 500000))
        && data.address is string && data.address.size() > 0 && data.address.size() <= 240
        && data.area is string && data.area.size() > 0 && data.area.size() <= 80
        && data.city is string && data.city.size() > 0 && data.city.size() <= 60
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.isVisible is bool
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidSecondAdmin(data) {
      return data.keys().hasAll(['adminId', 'name', 'email', 'phone', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'adminId', 'firebaseUid', 'name', 'title', 'email', 'phone',
          'passwordHash', 'createdBy', 'profilePhotoUrl', 'mapLocation',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.adminId is string && data.adminId.size() > 0 && data.adminId.size() <= 64
        && data.adminId.matches('^[a-zA-Z0-9_\\-]+$')
        && (!('firebaseUid' in data) || (data.firebaseUid is string && data.firebaseUid.size() <= 128))
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && (!('title' in data) || (data.title is string && data.title.size() <= 140))
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30
        && (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 64))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 160))
        && (!('profilePhotoUrl' in data) || (data.profilePhotoUrl is string && data.profilePhotoUrl.size() <= 500000))
        && (!('mapLocation' in data) || data.mapLocation is map)
        && data.status in ['active', 'disabled']
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidAcashDirectory(data) {
      return data.keys().hasAll([
          'accountId', 'role', 'name', 'phone', 'status', 'verified', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'accountId', 'firebaseUid', 'role', 'name', 'businessName', 'phone',
          'status', 'verified', 'createdAt', 'updatedAt'
        ])
        && data.accountId is string && data.accountId.size() <= 12 && data.accountId.matches('^[UAM]-\\d{6}$')
        && (!('firebaseUid' in data) || (data.firebaseUid is string && data.firebaseUid.size() <= 128))
        && data.role in ['U', 'A', 'M']
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 140))
        && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 20
        && data.status in ['active', 'disabled']
        && data.verified is bool
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidIdentityLock(data) {
      return data.keys().hasAll(['lockId', 'lockType', 'accountId', 'createdAt'])
        && data.keys().hasOnly(['lockId', 'lockType', 'accountId', 'createdAt'])
        && data.lockId is string && data.lockId.size() >= 6 && data.lockId.size() <= 128
        && data.lockId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.lockType in ['email', 'phone', 'nid', 'tax']
        && data.accountId is string && data.accountId.size() <= 12 && data.accountId.matches('^[UAM]-\\d{6}$')
        && data.createdAt is number;
    }

    // ---------- Boot Connection Health Check ----------
    match /test/connection {
      allow get: if true;
    }

    // ---------- Admins RBAC Registry ----------
    match /admins/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isRootAdminEmail());
      allow create, update: if isRootAdminEmail() && isValidId(uid)
        && incoming().keys().hasAll(['uid', 'email', 'createdAt'])
        && incoming().keys().hasOnly(['uid', 'email', 'createdAt'])
        && incoming().uid is string && incoming().uid.size() <= 128
        && incoming().email is string && incoming().email.size() <= 160
        && incoming().createdAt is number;
    }

    // ---------- Acash Users (PII Protected) ----------
    match /acash_users/{accountId} {
      allow get: if isVerifiedUser() && isValidId(accountId) && (
        existing().firebaseUid == request.auth.uid ||
        existing().email == request.auth.token.email ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.firebaseUid == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isRootAdminEmail()
      );
      allow create: if isValidId(accountId) && isValidAcashUser(incoming()) && incoming().accountId == accountId && (
        isAdmin() || (
          incoming().status == 'active' &&
          incoming().verified == true &&
          incoming().commissionBalance == 0 &&
          incoming().balance == (incoming().role == 'A' ? 100000 : (incoming().role == 'M' ? 15000 : 10000)) &&
          (
            (isVerifiedUser() && incoming().firebaseUid == request.auth.uid) ||
            (!isSignedIn() && !('firebaseUid' in incoming()))
          )
        )
      );
      allow update: if isVerifiedUser() && isValidId(accountId) && isValidAcashUser(incoming()) && (
        isAdmin() || (
          incoming().accountId == existing().accountId &&
          incoming().role == existing().role &&
          incoming().createdAt == existing().createdAt &&
          incoming().status == existing().status &&
          (
            (existing().firebaseUid == request.auth.uid &&
              incoming().firebaseUid == existing().firebaseUid &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'businessName', 'gender', 'phone', 'pinHash', 'staffPinHash',
                'profilePhotoUrl', 'kyc', 'mapLocation', 'verified', 'balance', 'commissionBalance', 'lastActiveAt'
              ])) ||
            (existing().email == request.auth.token.email &&
              incoming().firebaseUid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'firebaseUid', 'profilePhotoUrl', 'lastActiveAt'
              ])) ||
              (incoming().balance >= existing().balance &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'balance', 'commissionBalance', 'lastActiveAt'
                ]))
            )
          )
        );
    }

    // ---------- Acash Public Account Routing Directory (Non-PII Split Collection) ----------
    match /acash_directory/{accountId} {
      allow get: if isValidId(accountId);
      allow list: if request.query.limit != null && request.query.limit <= 500;
      allow create: if isValidId(accountId) && isValidAcashDirectory(incoming()) && incoming().accountId == accountId && (
        isAdmin() || (
          incoming().status == 'active' &&
          incoming().verified == true &&
          (
            (isVerifiedUser() && incoming().firebaseUid == request.auth.uid) ||
            (!isSignedIn() && !('firebaseUid' in incoming()))
          )
        )
      );
      allow update: if isVerifiedUser() && isValidId(accountId) && isValidAcashDirectory(incoming())
        && incoming().accountId == existing().accountId
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (existing().firebaseUid == request.auth.uid && incoming().firebaseUid == existing().firebaseUid) ||
          (!('firebaseUid' in existing()) && incoming().firebaseUid == request.auth.uid)
        );
    }

    // ---------- Zero-PII Deterministic Identity & KYC Uniqueness Locks ----------
    match /acash_identity_locks/{lockId} {
      allow get: if isValidId(lockId);
      allow create: if isValidId(lockId) && isValidIdentityLock(incoming()) && incoming().lockId == lockId;
      allow update: if isAdmin() && isValidId(lockId) && isValidIdentityLock(incoming()) && incoming().lockId == lockId;
      allow delete: if isAdmin() && isValidId(lockId);
    }

    // ---------- Acash Financial Transactions ----------
    match /acash_transactions/{txId} {
      allow get: if isVerifiedUser() && isValidId(txId) && (
        existing().senderUid == request.auth.uid ||
        existing().receiverUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        isRootAdminEmail()
      );
      allow create: if isVerifiedUser() && isValidId(txId) && isValidAcashTransaction(incoming()) && (
        incoming().senderUid == request.auth.uid || isAdmin()
      );
      allow update: if isVerifiedUser() && isValidId(txId) && isValidAcashTransaction(incoming()) && isAdmin()
        && incoming().txId == existing().txId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(txId);
    }

    // ---------- Acash Agent Booths & Customer Support Booths (Public Non-PII Map Directory) ----------
    match /acash_booths/{boothId} {
      allow get: if isValidId(boothId);
      allow list: if request.query.limit != null && request.query.limit <= 300;
      allow create: if isAdmin() && isValidId(boothId) && isValidAcashBooth(incoming());
      allow update: if isAdmin() && isValidId(boothId) && isValidAcashBooth(incoming())
        && incoming().boothId == existing().boothId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(boothId);
    }

    // ---------- Creator Live Map Locations (2nd Admins, Merchants, Agents) ----------
    match /acash_map_locations/{creatorId} {
      allow get: if isValidId(creatorId);
      allow list: if request.query.limit != null && request.query.limit <= 300;
      allow create: if isVerifiedUser() && isValidId(creatorId) && isValidAcashMapLocation(incoming()) && (
        isAdmin() || incoming().creatorUid == request.auth.uid
      );
      allow update: if isVerifiedUser() && isValidId(creatorId) && isValidAcashMapLocation(incoming())
        && incoming().creatorId == existing().creatorId
        && incoming().creatorRole == existing().creatorRole
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (existing().creatorUid == request.auth.uid && incoming().creatorUid == existing().creatorUid)
        );
      allow delete: if isValidId(creatorId) && (
        isAdmin() || (isVerifiedUser() && existing().creatorUid == request.auth.uid)
      );
    }

    // ---------- 2nd Admin Profiles (PII Protected) ----------
    match /acash_second_admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (
        existing().firebaseUid == request.auth.uid ||
        existing().email == request.auth.token.email ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.firebaseUid == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isRootAdminEmail()
      );
      allow create: if isAdmin() && isValidId(adminId) && isValidSecondAdmin(incoming());
      allow update: if isVerifiedUser() && isValidId(adminId) && isValidSecondAdmin(incoming())
        && incoming().adminId == existing().adminId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() || (
            incoming().email == existing().email &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'firebaseUid', 'name', 'title', 'phone', 'profilePhotoUrl', 'mapLocation', 'updatedAt'
            ]) && (
              (existing().firebaseUid == request.auth.uid && incoming().firebaseUid == existing().firebaseUid) ||
              existing().email == request.auth.token.email
            )
          )
        );
      allow delete: if isAdmin() && isValidId(adminId);
    }

    // ---------- Platform Settings ----------
    match /acash_settings/{settingId} {
      allow get: if isValidId(settingId) && (
        settingId == 'main_admin_credentials' ? isAdmin() : isSignedIn()
      );
      allow create, update: if isAdmin() && isValidId(settingId)
        && incoming().updatedAt is number;
    }

    // ---------- Admin Notifications & Activity Logs ----------
    match /acash_admin_notifications/{notifId} {
      allow get: if isAdmin() && isValidId(notifId);
      allow list: if isRootAdminEmail();
      allow create: if isVerifiedUser() && isValidId(notifId) && isValidAdminNotification(incoming());
      allow update: if isAdmin() && isValidId(notifId) && isValidAdminNotification(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }

    match /acash_admin_activity_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isRootAdminEmail();
      allow create: if isAdmin() && isValidId(logId) && isValidAdminActivityLog(incoming());
    }
  }
}
