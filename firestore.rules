rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAccountId(id) {
      return id is string && id.size() <= 12 && id.matches('^[UAM]-[0-9]{6}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidAcashUser(data, accountId) {
      return data.keys().hasAll(['accountId', 'role', 'name', 'phone', 'email', 'pinHash', 'balance', 'commissionBalance', 'status', 'verified', 'createdAt', 'lastActiveAt'])
        && data.accountId == accountId
        && data.role in ['U', 'A', 'M']
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.phone is string && data.phone.size() <= 30
        && data.email is string && data.email.size() <= 160
        && data.pinHash is string && data.pinHash.size() <= 64
        && data.balance is number && data.balance >= 0
        && data.commissionBalance is number && data.commissionBalance >= 0
        && data.status in ['active', 'disabled']
        && data.verified is bool
        && data.createdAt is number
        && data.lastActiveAt is number;
    }

    function isValidAcashTransaction(data, txId) {
      return data.keys().hasAll(['txId', 'txHash', 'type', 'senderId', 'receiverId', 'amount', 'fee', 'totalDebited', 'status', 'refundedAmount', 'createdAt'])
        && data.txId == txId
        && data.txHash is string && data.txHash.size() <= 64
        && data.type in ['send_money', 'cash_out', 'cash_in', 'agent_cash_out', 'merchant_cash_out', 'mobile_recharge', 'bill_pay', 'merchant_payment', 'b2b_transfer', 'refund', 'admin_credit', 'admin_transfer']
        && data.senderId is string && data.senderId.size() <= 32
        && data.receiverId is string && data.receiverId.size() <= 32
        && data.amount is number && data.amount > 0
        && data.fee is number && data.fee >= 0
        && data.totalDebited is number && data.totalDebited >= 0
        && data.status in ['completed', 'pending_admin_approval', 'rejected', 'refunded', 'partially_refunded']
        && data.refundedAmount is number && data.refundedAmount >= 0
        && data.createdAt is number
        && (!('giftCard' in data) || (
          data.giftCard is map
          && data.giftCard.cardId is string && data.giftCard.cardId.size() > 0 && data.giftCard.cardId.size() <= 64
          && data.giftCard.cardTitleBn is string && data.giftCard.cardTitleBn.size() <= 120
          && data.giftCard.cardTitleEn is string && data.giftCard.cardTitleEn.size() <= 120
          && data.giftCard.themeCategory in ['eid', 'boishakh', 'heritage', 'love', 'wishes', 'celebration', 'others']
          && data.giftCard.message is string && data.giftCard.message.size() <= 1000
          && data.giftCard.signaturePrefix in ['bn', 'en']
          && data.giftCard.senderDisplayName is string && data.giftCard.senderDisplayName.size() <= 140
          && data.giftCard.isCustomEdited is bool
          && (!('customImageUrl' in data.giftCard) || (data.giftCard.customImageUrl is string && data.giftCard.customImageUrl.size() <= 450000))
        ));
    }

    function isValidCustomGiftCard(data, cardId) {
      return data.keys().hasAll(['cardId', 'titleBn', 'titleEn', 'themeCategory', 'imageUrl', 'featured', 'active', 'createdBy', 'createdAt', 'updatedAt'])
        && data.cardId == cardId
        && data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 120
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 120
        && data.themeCategory in ['eid', 'boishakh', 'heritage', 'love', 'wishes', 'celebration', 'others']
        && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 650000
        && data.featured is bool
        && data.active is bool
        && (!('frozen' in data) || data.frozen is bool)
        && (!('featuredFirst' in data) || data.featuredFirst is bool)
        && (!('pinnedOrder' in data) || data.pinnedOrder is number)
        && (!('isUserSubmitted' in data) || data.isUserSubmitted is bool)
        && (!('expiresAt' in data) || data.expiresAt is number)
        && data.createdBy is string && data.createdBy.size() <= 160
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function canReadPortalRecord() {
      return isSignedIn() || request.time.toMillis() > 0;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /test/{docId} {
      allow get: if isSignedIn() || docId == 'connection';
      allow list, write: if isSignedIn();
    }

    match /acash_users/{accountId} {
      allow get, list: if canReadPortalRecord();
      allow create: if isValidAccountId(accountId) && isValidAcashUser(incoming(), accountId);
      allow update: if isValidAccountId(accountId)
        && incoming().accountId == accountId
        && incoming().role == resource.data.role
        && (
          isValidAcashUser(incoming(), accountId)
          || (
            incoming().balance is number && incoming().balance >= 0
            && incoming().lastActiveAt is number
          )
        );
      allow delete: if isValidAccountId(accountId);
    }

    match /acash_directory/{accountId} {
      allow get, list: if canReadPortalRecord();
      allow create, update: if isValidAccountId(accountId)
        && incoming().accountId == accountId
        && incoming().role in ['U', 'A', 'M']
        && incoming().name is string && incoming().name.size() <= 160;
      allow delete: if isValidAccountId(accountId);
    }

    match /acash_kyc_submissions/{accountId} {
      allow get, list: if canReadPortalRecord();
      allow create, update: if isValidAccountId(accountId)
        && incoming().accountId == accountId
        && incoming().kyc is map
        && incoming().updatedAt is number;
      allow delete: if isValidAccountId(accountId);
    }

    match /acash_identity_locks/{lockId} {
      allow get, list: if canReadPortalRecord();
      allow create, update: if isValidId(lockId)
        && incoming().lockId == lockId
        && incoming().lockType in ['email', 'phone', 'nid', 'tax']
        && incoming().accountId is string
        && incoming().createdAt is number;
      allow delete: if isValidId(lockId);
    }

    match /acash_transactions/{txId} {
      allow get, list: if canReadPortalRecord();
      allow create, update: if isValidId(txId) && isValidAcashTransaction(incoming(), txId);
      allow delete: if isValidId(txId);
    }

    match /acash_booths/{boothId} {
      allow get, list: if canReadPortalRecord();
      allow create, update: if isValidId(boothId)
        && incoming().boothId == boothId
        && incoming().boothType in ['agent_booth', 'support_booth']
        && incoming().lat is number && incoming().lng is number;
      allow delete: if isValidId(boothId);
    }

    match /acash_map_locations/{creatorId} {
      allow get, list: if canReadPortalRecord();
      allow create, update: if isValidId(creatorId)
        && incoming().creatorId == creatorId
        && incoming().creatorRole in ['agent', 'merchant', 'admin', 'second_admin']
        && incoming().lat is number && incoming().lng is number;
      allow delete: if isValidId(creatorId);
    }

    match /acash_second_admins/{adminId} {
      allow get, list: if canReadPortalRecord();
      allow create, update: if isValidId(adminId)
        && incoming().adminId == adminId
        && incoming().email is string
        && incoming().status in ['active', 'disabled'];
      allow delete: if isValidId(adminId);
    }

    match /acash_settings/{settingId} {
      allow get, list: if canReadPortalRecord();
      allow create, update: if settingId in ['fee_config', 'admin_alert', 'main_admin_credentials', 'treasury_vault', 'portal_theme', 'gift_card_overrides']
        && incoming().updatedAt is number;
      allow delete: if settingId in ['fee_config', 'admin_alert', 'main_admin_credentials', 'treasury_vault', 'portal_theme', 'gift_card_overrides'];
    }

    match /acash_gift_cards/{cardId} {
      allow get, list: if canReadPortalRecord();
      allow create, update: if isValidId(cardId) && isValidCustomGiftCard(incoming(), cardId);
      allow delete: if isValidId(cardId);
    }

    match /acash_admin_notifications/{notifId} {
      allow get, list: if canReadPortalRecord();
      allow create, update: if isValidId(notifId)
        && incoming().id == notifId
        && incoming().createdAt is number;
      allow delete: if isValidId(notifId);
    }

    match /acash_admin_activity_logs/{logId} {
      allow get, list: if canReadPortalRecord();
      allow create, update: if isValidId(logId)
        && incoming().id == logId
        && incoming().timestamp is number;
      allow delete: if isValidId(logId);
    }

    match /acash_account_notifications/{notifId} {
      allow get, list: if canReadPortalRecord();
      allow create, update: if isValidId(notifId)
        && incoming().id == notifId
        && incoming().recipientId is string && incoming().recipientId.size() > 0 && incoming().recipientId.size() <= 32
        && incoming().title is string && incoming().title.size() <= 200
        && incoming().message is string && incoming().message.size() <= 1000
        && incoming().read is bool
        && incoming().createdAt is number;
      allow delete: if isValidId(notifId);
    }

    match /admins/{uid} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
